# Default: private local SQLite. Nothing silently switches during outages.
CAREER_BACKEND=sqlite
PORT=4317
# Optional dedicated Supabase project; apply supabase/schema.sql first.
# CAREER_BACKEND=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-server-only-secret
# Never put secret/service-role keys in VITE_ variables or client source.
# CAREER_DATA_DIR=/absolute/private/directory
# CAREER_RESUME_PATH=/absolute/path/to/your-resume.pdf
